# Copy this file to `.env` and fill in the values.

# Source - Xom Data SQL Server (read-only)
OLTP_HOST=<sql-server-host>
OLTP_PORT=1433
OLTP_DATABASE=<database-name>
OLTP_USERNAME=<username>
OLTP_PASSWORD=<password>
OLTP_SCHEMA=retails

# Bronze layer - MinIO (must match docker-compose.yaml)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_SECURE=false
MINIO_BRONZE_BUCKET=bronze

# Silver/Gold layer - DuckDB warehouse file.
# Use an absolute path: dbt runs from the dbt/ folder, a relative path would resolve there.
DUCKDB_PATH=C:/CS/Project/retail_sales/duckdb_warehouse/warehouse.duckdb

# Text-to-SQL engine
# LLM_PROVIDER: "gemini" (needs GOOGLE_API_KEY) or "rules" (offline, no key).
# Leave unset to auto-select: Gemini when a key is present, otherwise offline.
LLM_PROVIDER=gemini
# Free tier, no payment details required: https://aistudio.google.com/apikey
GOOGLE_API_KEY=<google-ai-studio-key>
TEXT2SQL_MODEL=gemini-2.5-flash
